DATABASE_URL=file:./data/grimm-latam.db
# Required only for a remote LibSQL/Turso production database.
DATABASE_AUTH_TOKEN=
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Google service account JSON is a server-only encrypted Vercel variable. Never commit it.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SEARCH_CONSOLE_PROPERTY=sc-domain:grimmfirepump.cl
# Required to authorize Vercel Cron requests to /api/cron/search-console.
CRON_SECRET=replace-with-a-long-random-secret
